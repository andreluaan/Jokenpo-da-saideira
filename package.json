{
  "name": "ppt-da-saideira",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ppt/client",
    "build": "npm run build -w @ppt/client",
    "preview": "npm run preview -w @ppt/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/shared/tsconfig.json && tsc -p packages/client/tsconfig.json"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
